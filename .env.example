# Hyphae Consensus environment template. NEVER commit real secrets.
# Fake-mode demos and tests need none of these.

# Meta Model API (live model=meta). Base URL is https://api.meta.ai/v1.
# The key is read from the key FILE first, else the FIRST of the variables
# that is set, never printed, and zeroized when the process drops it. Muse
# Code subscription credentials are not valid API keys. Documented key
# shape: LLM_<numeric id>_<secret>.
# File whose trimmed content is the key (systemd LoadCredential on the
# public server; empty or unreadable stops startup naming this variable):
# CONSENSUS_META_API_KEY_FILE=
# CONSENSUS_META_API_KEY=
# MODEL_API_KEY=
# META_API_KEY=
# Application inference model (exact identity recorded in receipts):
# CONSENSUS_MODEL=muse-wonder-1.0
# CONSENSUS_META_BASE_URL=https://api.meta.ai/v1   (https; http only on loopback)
# One budget for the whole call: every attempt, wait and body read (1..3600):
# CONSENSUS_MODEL_TIMEOUT_SECS=120
# Output cap per call; reasoning tokens count against it and are billed as
# output (observed maximum output so far: 10,692 tokens):
# CONSENSUS_META_MAX_COMPLETION_TOKENS=16000
# Unset = not sent. minimal|low|medium|high|xhigh|max ("none" is refused):
# CONSENSUS_META_REASONING_EFFORT=
# Attempts per call (1..10); 429, 503 and pre-send connection failures are
# retried, with full-jitter backoff and a bounded Retry-After, plus the one
# post-send retry below:
# CONSENSUS_META_MAX_ATTEMPTS=3
# Retry ONCE when the connection breaks after the request was sent (reset,
# EOF; no HTTP status), within the attempts and budget above. The lost attempt
# may already have been billed, so this can bill one duplicate call that no
# invocation records; ADR-0007's planned ledger (not yet in this tree) charges
# such a failure at worst case; until it lands nothing accounts for the
# duplicate. Timeouts, 504 and non-retryable 4xx are never retried:
# CONSENSUS_META_RETRY_TRANSPORT_ONCE=true
# Public deployment flag: refuses the raw draft dump below and other
# development-only behavior:
# CONSENSUS_PUBLIC_MODE=false
# Per-run cap on input + output tokens across all model calls (positive
# integer; an invalid value stops the console at startup):
# CONSENSUS_MAX_RUN_TOKENS=150000

# Hyphae Agent Memory (live memory=hyphae). A file PATH to a restricted
# reader key, never the value, plus one transport selector pointing at an
# ISOLATED deployment (never the primary Agent Memory data):
# HYPHAE_NATIVE_API_KEY_FILE=
# HYPHAE_NATIVE_ENDPOINT=    (preferred same-machine transport; the daemon's
#                             socket must sit OUTSIDE its data directory)
# HYPHAE_BASE_URL=           (or loopback http / remote https origin)
# CONSENSUS_HYPHAE_BIN=hyphae
# Optional out-of-band proof anchor (64 hex, normalized to lowercase);
# records anchored elsewhere verify as invalid. Without it, Valid means
# self-consistency against the anchor the backend itself reported:
# CONSENSUS_HYPHAE_EXPECTED_ANCHOR=
# Deadline for one `hyphae proof verify` process; it is killed on expiry:
# CONSENSUS_HYPHAE_VERIFY_TIMEOUT_SECS=60

# Sealed snapshot evidence (public live mode, ADR-0008): the directory holding
# manifest.json, SHA256SUMS and captures/. With it, CONSENSUS_HYPHAE_EXPECTED_ANCHOR
# is REQUIRED and must equal the manifest's anchor_hex, or boot fails:
# CONSENSUS_SNAPSHOT_DIR=
# The same directory as the verifier binary sees it, only when CONSENSUS_HYPHAE_BIN
# runs hyphae elsewhere (scripts/hyphae-docker.cmd: the container path):
# CONSENSUS_SNAPSHOT_VERIFIER_DIR=

# Console (optional):
# CONSENSUS_BIND=127.0.0.1:8787
# CONSENSUS_EVENT_LOG=<a fresh file>   (default demo-run/events.jsonl; never
#                                       point it at research/ or at an archived
#                                       battery log: the console appends to it)
# Optional explicit Agent Memory collections (manually provisioned stores):
# CONSENSUS_HYPHAE_PERSONAL_COLLECTION=
# CONSENSUS_HYPHAE_WORK_COLLECTION=
# CONSENSUS_HYPHAE_JOURNAL_COLLECTION=
# Opt-in raw Meta draft capture for debugging (model output only; never in a
# public deployment):
# CONSENSUS_META_DEBUG_DIR=

# Live integration tests stay off unless explicitly enabled:
# CONSENSUS_LIVE_TESTS=0
# CONSENSUS_LIVE_PROJECT=demo-repo     (project the gated live tests recall)

# Public live mode (serve-public only; ADR-0007). Runs on the owner's key
# above behind Turnstile, a USD ledger and the geographic policy. Every
# value is validated at startup; an invalid one stops the server naming its
# variable. Money is decimal USD, never floats.
# CONSENSUS_LIVE_ENABLED=false            (public-only; true needs the key, the ledger dir, Turnstile and the sealed snapshot)
# CONSENSUS_LIVE_LEDGER_DIR=              (public-only; required when enabled: the append-only USD ledger directory)
# CONSENSUS_LIVE_DAILY_USD=10.00          (public-only; cap per UTC day, public and operator lanes)
# CONSENSUS_LIVE_LIFETIME_USD=60.00       (public-only; lifetime cap, judge slice included)
# CONSENSUS_LIVE_JUDGE_USD=15.00          (public-only; judge-lane slice inside the lifetime cap)
# CONSENSUS_LIVE_JUDGE_DAILY_USD=         (public-only; judge reservations per UTC day; default: the slice)
# CONSENSUS_LIVE_JUDGE_CODES_FILE=        (public-only; SHA-256 hex digests of invite codes, one per line; unset = lane closed)
# CONSENSUS_LIVE_MAX_CONCURRENT=1         (public-only; public live reservations active at once, per process)
# CONSENSUS_LIVE_HOURLY_ADMISSIONS=6      (public-only; reservations per rolling hour, per lane)
# CONSENSUS_LIVE_BURST_FRACTION=0.25      (public-only; share of the daily cap available at 00:00 UTC)
# CONSENSUS_LIVE_RUN_TOKEN_CAP=70000      (public-only; per-run token cap of live runs)
# CONSENSUS_LIVE_MAX_COMPLETION_TOKENS=16000 (public-only; max_completion_tokens sent on public live calls)
# CONSENSUS_LIVE_INPUT_CAP_TOKENS=8000    (public-only; input bound per call)
# CONSENSUS_META_PRICE_INPUT_PER_M=4.00   (public-only; USD per million input tokens, for the ledger)
# CONSENSUS_META_PRICE_OUTPUT_PER_M=20.00 (public-only; USD per million output and reasoning tokens)
# CONSENSUS_LIVE_KILL_SWITCH_FILE=        (public-only; its presence trips the ledger; default <ledger dir>/kill-switch)
# CONSENSUS_LIVE_EXPOSURE_DAYS=           (public-only; when set, daily x days <= lifetime is enforced)
# CONSENSUS_TURNSTILE_SECRET_FILE=        (public-only; required when enabled; Cloudflare test secrets are refused)
# CONSENSUS_TURNSTILE_HOSTNAME=           (public-only; required when enabled; bare host name expected in Siteverify answers)
# CONSENSUS_TURNSTILE_ACTION_LIVE=live-run (public-only; widget action of a live-run token)
# CONSENSUS_TURNSTILE_ACTION_SESSION=session (public-only; widget action of a session token; must differ)
# CONSENSUS_GEO_BLOCKED_COUNTRIES=        (public-only; portal-wide block, ISO alpha-2 list; default: Meta's Restricted Territories plus UA)
# CONSENSUS_GEO_LIVE_ONLY_BLOCKED=KR      (public-only; live-only block)
# CONSENSUS_SNAPSHOT_DIR=                 (public-only; the sealed Hyphae snapshot live runs recall from, ADR-0008; required when enabled, boot-verified at startup with CONSENSUS_HYPHAE_EXPECTED_ANCHOR)
