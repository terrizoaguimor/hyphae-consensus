# Hyphae Consensus environment template. NEVER commit real secrets.
# Fake-mode demos and tests need none of these.

# Meta Model API (live model=meta). Base URL is https://api.meta.ai/v1.
# The key is read from the FIRST of these that is set, never printed, and
# zeroized when the process drops it. Muse Code subscription credentials are
# not valid API keys. Documented key shape: LLM_<numeric id>_<secret>.
# CONSENSUS_META_API_KEY=
# MODEL_API_KEY=
# META_API_KEY=
# Application inference model (exact identity recorded in receipts):
# CONSENSUS_MODEL=muse-wonder-1.0
# CONSENSUS_META_BASE_URL=https://api.meta.ai/v1   (https; http only on loopback)
# One budget for the whole call: every attempt, wait and body read (1..3600):
# CONSENSUS_MODEL_TIMEOUT_SECS=120
# Output cap per call; reasoning tokens count against it and are billed as
# output (observed maximum output so far: 10,692 tokens):
# CONSENSUS_META_MAX_COMPLETION_TOKENS=16000
# Unset = not sent. minimal|low|medium|high|xhigh|max ("none" is refused):
# CONSENSUS_META_REASONING_EFFORT=
# Attempts per call (1..10); 429, 503 and pre-send connection failures are
# retried, with full-jitter backoff and a bounded Retry-After, plus the one
# post-send retry below:
# CONSENSUS_META_MAX_ATTEMPTS=3
# Retry ONCE when the connection breaks after the request was sent (reset,
# EOF; no HTTP status), within the attempts and budget above. The lost attempt
# may already have been billed, so this can bill one duplicate call that no
# invocation records; ADR-0007's planned ledger (not yet in this tree) charges
# such a failure at worst case; until it lands nothing accounts for the
# duplicate. Timeouts, 504 and non-retryable 4xx are never retried:
# CONSENSUS_META_RETRY_TRANSPORT_ONCE=true
# Public deployment flag: refuses the raw draft dump below and other
# development-only behavior:
# CONSENSUS_PUBLIC_MODE=false
# Per-run cap on input + output tokens across all model calls (positive
# integer; an invalid value stops the console at startup):
# CONSENSUS_MAX_RUN_TOKENS=150000

# Hyphae Agent Memory (live memory=hyphae). A file PATH to a restricted
# reader key, never the value, plus one transport selector pointing at an
# ISOLATED deployment (never the primary Agent Memory data):
# HYPHAE_NATIVE_API_KEY_FILE=
# HYPHAE_NATIVE_ENDPOINT=    (preferred same-machine transport; the daemon's
#                             socket must sit OUTSIDE its data directory)
# HYPHAE_BASE_URL=           (or loopback http / remote https origin)
# CONSENSUS_HYPHAE_BIN=hyphae
# Optional out-of-band proof anchor (64 hex, normalized to lowercase);
# records anchored elsewhere verify as invalid. Without it, Valid means
# self-consistency against the anchor the backend itself reported:
# CONSENSUS_HYPHAE_EXPECTED_ANCHOR=
# Deadline for one `hyphae proof verify` process; it is killed on expiry:
# CONSENSUS_HYPHAE_VERIFY_TIMEOUT_SECS=60

# Console (optional):
# CONSENSUS_BIND=127.0.0.1:8787
# CONSENSUS_EVENT_LOG=<a fresh file>   (default demo-run/events.jsonl; never
#                                       point it at research/ or at an archived
#                                       battery log: the console appends to it)
# Optional explicit Agent Memory collections (manually provisioned stores):
# CONSENSUS_HYPHAE_PERSONAL_COLLECTION=
# CONSENSUS_HYPHAE_WORK_COLLECTION=
# CONSENSUS_HYPHAE_JOURNAL_COLLECTION=
# Opt-in raw Meta draft capture for debugging (model output only; never in a
# public deployment):
# CONSENSUS_META_DEBUG_DIR=

# Live integration tests stay off unless explicitly enabled:
# CONSENSUS_LIVE_TESTS=0
# CONSENSUS_LIVE_PROJECT=demo-repo     (project the gated live tests recall)
