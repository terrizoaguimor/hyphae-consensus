# Hyphae Consensus environment template. NEVER commit real secrets.
# Fake-mode demos and tests need none of these.

# Meta Model API (live model=meta). Base URL is https://api.meta.ai/v1
# META_API_KEY=            (MODEL_API_KEY is also accepted)
# Application inference model (exact identity recorded in receipts):
# CONSENSUS_MODEL=muse-wonder-1.0
# CONSENSUS_META_BASE_URL=https://api.meta.ai/v1
# CONSENSUS_MODEL_TIMEOUT_SECS=120      (per call; default 120)
# Per-run cap on input + output tokens across all model calls (positive
# integer; an invalid value stops the console at startup):
# CONSENSUS_MAX_RUN_TOKENS=150000

# Hyphae Agent Memory (live memory=hyphae). A file PATH to a restricted
# reader key, never the value, plus one transport selector pointing at an
# ISOLATED deployment (never the primary Agent Memory data):
# HYPHAE_NATIVE_API_KEY_FILE=
# HYPHAE_NATIVE_ENDPOINT=    (preferred same-machine transport; the daemon's
#                             socket must sit OUTSIDE its data directory)
# HYPHAE_BASE_URL=           (or loopback http / remote https origin)
# CONSENSUS_HYPHAE_BIN=hyphae
# Optional out-of-band proof anchor (64 hex); records anchored elsewhere
# verify as invalid:
# CONSENSUS_HYPHAE_EXPECTED_ANCHOR=

# Console (optional):
# CONSENSUS_BIND=127.0.0.1:8787
# CONSENSUS_EVENT_LOG=<a fresh file>   (default demo-run/events.jsonl; never
#                                       point it at research/ or at an archived
#                                       battery log: the console appends to it)
# Optional explicit Agent Memory collections (manually provisioned stores):
# CONSENSUS_HYPHAE_PERSONAL_COLLECTION=
# CONSENSUS_HYPHAE_WORK_COLLECTION=
# CONSENSUS_HYPHAE_JOURNAL_COLLECTION=
# Opt-in raw Meta draft capture for debugging (model output only; never in a
# public deployment):
# CONSENSUS_META_DEBUG_DIR=

# Live integration tests stay off unless explicitly enabled:
# CONSENSUS_LIVE_TESTS=0
# CONSENSUS_LIVE_PROJECT=demo-repo     (project the gated live tests recall)
