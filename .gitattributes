# Container scripts run under Linux sh: keep LF even with core.autocrlf=true.
*.sh text eol=lf

# The research archive is stored and checked out byte for byte: its MANIFEST
# pins sha256 values and its event logs are hash-chained, so no line-ending
# conversion may ever touch it.
/research/** -text

# Sealed snapshots (ADR-0008) likewise: manifest.json and SHA256SUMS pin the
# sha256 of every file, and the published manifest digest pins manifest.json.
/snapshots/** -text

# The generated API contract is compared byte for byte by a test: keep LF.
/contracts/** text eol=lf

# Deployment templates and scripts are copied to a Linux server verbatim
# (systemd units, env files, cloudflared YAML): keep LF on every checkout.
/deploy/** text eol=lf
