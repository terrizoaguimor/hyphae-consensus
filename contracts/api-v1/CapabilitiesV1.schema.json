{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Authority": {
      "description": "Under whose authority a human decision was recorded (schema 1.3).",
      "oneOf": [
        {
          "description": "The operator of this deployment.",
          "enum": [
            "operator"
          ],
          "type": "string"
        },
        {
          "description": "A public visitor deciding on their own simulated run: the record carries no operational authority.",
          "enum": [
            "public_demo"
          ],
          "type": "string"
        }
      ]
    },
    "EvidenceProvenance": {
      "description": "Where the evidence came from, read from the verification and retrieval records.",
      "oneOf": [
        {
          "description": "Seeded records checked by the scripted verifier: SIMULATED.",
          "enum": [
            "simulated"
          ],
          "type": "string"
        },
        {
          "description": "Records of a sealed Hyphae snapshot, verified with `hyphae proof verify`.",
          "enum": [
            "hyphae_snapshot"
          ],
          "type": "string"
        },
        {
          "description": "Records recalled from a running Hyphae deployment.",
          "enum": [
            "hyphae_live"
          ],
          "type": "string"
        },
        {
          "description": "No evidence record in the run.",
          "enum": [
            "none"
          ],
          "type": "string"
        },
        {
          "description": "Records of more than one kind.",
          "enum": [
            "mixed"
          ],
          "type": "string"
        }
      ]
    },
    "LimitsV1": {
      "description": "Every limit the server enforces.",
      "properties": {
        "body_limit_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "guided_concurrency": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "guided_ring": {
          "description": "Visitor runs the store keeps at once; when full, the oldest resting visitor runs are purged to admit a new one.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "list_page_max": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "live_concurrency": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_run_tokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "rate_runs_per_min": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "rate_session_per_min": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "rate_sse_per_min": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "request_timeout_secs": {
          "description": "Seconds a request may take to be handled (body read included; a stream's body is not covered once its headers are sent).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "run_deadline_secs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "session_max": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "session_ttl_secs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "sse_heartbeat_secs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "sse_max_global": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "sse_max_per_client": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "sse_max_per_run": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "visitor_access_hours": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "visitor_delete_days": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "body_limit_bytes",
        "guided_concurrency",
        "guided_ring",
        "list_page_max",
        "live_concurrency",
        "max_run_tokens",
        "rate_runs_per_min",
        "rate_session_per_min",
        "rate_sse_per_min",
        "request_timeout_secs",
        "run_deadline_secs",
        "session_max",
        "session_ttl_secs",
        "sse_heartbeat_secs",
        "sse_max_global",
        "sse_max_per_client",
        "sse_max_per_run",
        "visitor_access_hours",
        "visitor_delete_days"
      ],
      "type": "object"
    },
    "LiveCapabilitiesV1": {
      "description": "The live section of `/capabilities`, present when live mode is wired.",
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/definitions/PublicBudgetV1"
            },
            {
              "type": "null"
            }
          ],
          "description": "The visitor-safe budget. Absent when the ledger could not be read: no run can be admitted until it can (`/ready` then reports `live.ledger_ok: false`), and no figure is invented in its place."
        },
        "client_daily": {
          "description": "Public-lane live runs one network (client key) may start per UTC day (`CONSENSUS_LIVE_CLIENT_DAILY`). A run that Meta or the model ended before any recommendation is given back, up to 2 a day. Absent from servers that predate it.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "invite_code_daily": {
          "description": "Live runs one invite code may start per UTC day (`CONSENSUS_LIVE_JUDGE_CODE_DAILY`), with the same give-back. Absent from servers that predate it.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "presets": {
          "items": {
            "$ref": "#/definitions/PresetV1"
          },
          "type": "array"
        },
        "requires_adult_attestation": {
          "description": "Always true: `attest_adult` must be true on every live run.",
          "type": "boolean"
        },
        "requires_turnstile": {
          "description": "Always true: a Turnstile token must accompany every live run.",
          "type": "boolean"
        }
      },
      "required": [
        "presets",
        "requires_adult_attestation",
        "requires_turnstile"
      ],
      "type": "object"
    },
    "ModelProvenance": {
      "description": "Which model answered the roles, read from the chained `ModelInvocation` records (provider and request id), never from the request or the declared mode.",
      "oneOf": [
        {
          "description": "Every recorded call came from a scripted double (`provider=fake`): no model was called.",
          "enum": [
            "scripted"
          ],
          "type": "string"
        },
        {
          "description": "Every recorded call went to the Meta Model API (`provider=meta` with a request id).",
          "enum": [
            "live_meta"
          ],
          "type": "string"
        },
        {
          "description": "Calls from more than one provider, or Meta calls without request ids: shown with a flag, never as LIVE.",
          "enum": [
            "mixed"
          ],
          "type": "string"
        },
        {
          "description": "No model call recorded yet.",
          "enum": [
            "undetermined"
          ],
          "type": "string"
        }
      ]
    },
    "PresetV1": {
      "description": "One curated live preset, as `/capabilities` lists it: a canned task the recorded batteries ran, never visitor text.",
      "properties": {
        "description": {
          "type": "string"
        },
        "evidence": {
          "allOf": [
            {
              "$ref": "#/definitions/EvidenceProvenance"
            }
          ],
          "description": "Where the evidence comes from in this deployment (the sealed snapshot in production)."
        },
        "id": {
          "description": "The battery tag, e.g. `R03-raise-to-10`: the `preset_id` to send.",
          "type": "string"
        },
        "model": {
          "allOf": [
            {
              "$ref": "#/definitions/ModelProvenance"
            }
          ],
          "description": "Always `live_meta`: the owner's Meta key answers every role."
        },
        "project": {
          "description": "The project every preset runs against (`demo-repo`).",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "evidence",
        "id",
        "model",
        "project",
        "title"
      ],
      "type": "object"
    },
    "PublicBudgetV1": {
      "description": "What `/capabilities` publishes about the live budget: remaining amounts as the ledger renders them (USD, six decimals), whether live mode is tripped and the coarse reason code. Never an amount spent, a detail string, an upstream status or a path; the judge lane is not mentioned.",
      "properties": {
        "daily_available_now": {
          "description": "What the public lane could reserve right now, pacing included.",
          "type": "string"
        },
        "daily_remaining": {
          "description": "Today's remaining public budget (UTC day).",
          "type": "string"
        },
        "lifetime_remaining": {
          "type": "string"
        },
        "trip_code": {
          "description": "`kill_switch`, `lifetime_cap`, `output_bound`, `charge_bound`, `provider_refused_key` or `inconsistent`, when tripped.",
          "type": [
            "string",
            "null"
          ]
        },
        "tripped": {
          "description": "True when the ledger refuses every admission until an operator resets it, or when the operator's kill-switch file exists (reported at once, before the next admission records the trip).",
          "type": "boolean"
        }
      },
      "required": [
        "daily_available_now",
        "daily_remaining",
        "lifetime_remaining",
        "tripped"
      ],
      "type": "object"
    },
    "SurfaceV1": {
      "description": "Which server answered.",
      "enum": [
        "public",
        "operator"
      ],
      "type": "string"
    }
  },
  "description": "`GET /api/v1/capabilities`.",
  "properties": {
    "decision_authority": {
      "allOf": [
        {
          "$ref": "#/definitions/Authority"
        }
      ],
      "description": "Authority recorded on this surface's decisions."
    },
    "guided_enabled": {
      "type": "boolean"
    },
    "limits": {
      "$ref": "#/definitions/LimitsV1"
    },
    "live": {
      "anyOf": [
        {
          "$ref": "#/definitions/LiveCapabilitiesV1"
        },
        {
          "type": "null"
        }
      ],
      "description": "Presets, budget and requirements of the public live mode; absent when live mode is not wired on this server."
    },
    "live_enabled": {
      "type": "boolean"
    },
    "policy_version": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "showcase_enabled": {
      "type": "boolean"
    },
    "surface": {
      "$ref": "#/definitions/SurfaceV1"
    }
  },
  "required": [
    "decision_authority",
    "guided_enabled",
    "limits",
    "live_enabled",
    "policy_version",
    "protocol",
    "schema_version",
    "showcase_enabled",
    "surface"
  ],
  "title": "CapabilitiesV1",
  "type": "object"
}
