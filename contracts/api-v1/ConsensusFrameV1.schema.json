{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Actor": {
      "description": "Who performed an action recorded in the event log. `Human` is the only actor kind allowed to authorize a run.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "agent"
              ],
              "type": "string"
            },
            "role": {
              "$ref": "#/definitions/AgentRole"
            }
          },
          "required": [
            "kind",
            "role"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "runtime"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "human"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "AgentRole": {
      "description": "The three logical agent roles. Roles may share one underlying model; they differ in instructions, context, and tool permissions.",
      "enum": [
        "proposer",
        "critic",
        "evidence_evaluator"
      ],
      "type": "string"
    },
    "AuthorizationState": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "type": "string"
    },
    "Challenge": {
      "description": "Critic output. The critic's job is to find problems, not to agree.",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/definitions/ChallengeItem"
          },
          "type": "array"
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "target_proposal": {
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "id",
        "items",
        "run_id",
        "schema_version",
        "target_proposal"
      ],
      "type": "object"
    },
    "ChallengeItem": {
      "description": "One specific objection raised by the Critic against a claim or plan. Items carry stable ids so resolution is tracked per objection, not per challenge document.",
      "properties": {
        "claim_id": {
          "description": "Claim under challenge, when the objection targets one claim.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "evidence_refs": {
          "description": "Evidence the critic believes contradicts or constrains the claim.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ChallengeKind"
        }
      },
      "required": [
        "description",
        "evidence_refs",
        "kind"
      ],
      "type": "object"
    },
    "ChallengeKind": {
      "enum": [
        "contradictory_evidence",
        "missing_test",
        "unsupported_claim",
        "regression_risk",
        "security_risk",
        "constraint_conflict"
      ],
      "type": "string"
    },
    "Claim": {
      "description": "One explicit, checkable assertion inside a proposal.",
      "properties": {
        "evidence_refs": {
          "description": "Evidence the author believes supports this claim (may be empty, which the evaluator treats as unsupported until retrieved).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        }
      },
      "required": [
        "evidence_refs",
        "id",
        "statement"
      ],
      "type": "object"
    },
    "ClaimAssessment": {
      "description": "Evaluator output: per-claim sufficiency judgment. Factual and relevance judgments live here; cryptographic integrity is reported separately in `EvidenceVerification` and is never inferred from this document.",
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "contradicting_evidence": {
          "default": [],
          "description": "Evidence the evaluator judges to contradict this claim.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "corroborated": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "relevant_evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "corroborated",
        "note",
        "relevant_evidence"
      ],
      "type": "object"
    },
    "ClearedContradiction": {
      "description": "A contradiction recorded in an earlier round that this evaluation judges no longer applies, with the reason (schema 1.3). Silence never clears a contradiction; only an entry here does.",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "reason"
      ],
      "type": "object"
    },
    "DecisionV1": {
      "description": "A recorded human decision.",
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "authority": {
          "description": "`operator`, `public_demo`, or `unspecified` for records that carry no authority (before schema 1.3). Never read as operator authority unless it says so.",
          "type": "string"
        },
        "authorized_by": {
          "type": "string"
        },
        "decided_at": {
          "type": "string"
        },
        "idempotency_key": {
          "description": "Operator surface only.",
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "notice": {
          "description": "Present for `public_demo`: the decision carries no operational authority.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "approved",
        "authority",
        "authorized_by",
        "decided_at"
      ],
      "type": "object"
    },
    "Delivery": {
      "description": "Whether an SSE frame carries a record stored before the stream began (`replay`) or one published while the client was connected (`live`).",
      "enum": [
        "replay",
        "live"
      ],
      "type": "string"
    },
    "Evaluation": {
      "properties": {
        "abstain": {
          "description": "True when the evaluator cannot reach a supported judgment and the correct behavior is to abstain rather than guess.",
          "type": "boolean"
        },
        "abstain_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "assessments": {
          "items": {
            "$ref": "#/definitions/ClaimAssessment"
          },
          "type": "array"
        },
        "cleared_contradictions": {
          "description": "Schema 1.3: contradictions carried from earlier rounds that this evaluation clears, each with its reason.",
          "items": {
            "$ref": "#/definitions/ClearedContradiction"
          },
          "type": "array"
        },
        "created_at": {
          "type": "string"
        },
        "item_verdicts": {
          "description": "Schema 1.3: one verdict for every objection under evaluation, the ones still open from earlier rounds and this round's. Empty on earlier records, which judged this round's items only, implicitly.",
          "items": {
            "$ref": "#/definitions/ItemVerdict"
          },
          "type": "array"
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "target_proposal": {
          "type": "string"
        },
        "unresolved_items": {
          "default": [],
          "description": "Challenge ITEM ids the evaluator judges still unresolved. From schema 1.3 exactly the ids of the `unresolved` verdicts.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "abstain",
        "assessments",
        "created_at",
        "run_id",
        "schema_version",
        "target_proposal"
      ],
      "type": "object"
    },
    "EventPayloadV1": {
      "description": "The payload of one event, as a client may see it. Tagged like the stored record (`type`), with the same variant names.",
      "oneOf": [
        {
          "properties": {
            "task": {
              "$ref": "#/definitions/Task"
            },
            "type": {
              "enum": [
                "task_created"
              ],
              "type": "string"
            }
          },
          "required": [
            "task",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "invocation": {
              "$ref": "#/definitions/ModelInvocationV1"
            },
            "proposal": {
              "$ref": "#/definitions/Proposal"
            },
            "type": {
              "enum": [
                "proposal_submitted"
              ],
              "type": "string"
            }
          },
          "required": [
            "invocation",
            "proposal",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "evidence": {
              "$ref": "#/definitions/EvidenceReferenceV1"
            },
            "type": {
              "enum": [
                "evidence_retrieved"
              ],
              "type": "string"
            }
          },
          "required": [
            "evidence",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "reason": {
              "description": "Operator surface only.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "enum": [
                "evidence_unavailable"
              ],
              "type": "string"
            }
          },
          "required": [
            "message",
            "query",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "anchor": {
              "type": "string"
            },
            "empty": {
              "type": "boolean"
            },
            "evidence_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "proof_ref": {
              "type": "string"
            },
            "request": {
              "$ref": "#/definitions/ProofRequest"
            },
            "type": {
              "enum": [
                "recall_proven"
              ],
              "type": "string"
            }
          },
          "required": [
            "anchor",
            "empty",
            "evidence_ids",
            "proof_ref",
            "request",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "evidence_verified"
              ],
              "type": "string"
            },
            "verification": {
              "$ref": "#/definitions/VerificationV1"
            }
          },
          "required": [
            "type",
            "verification"
          ],
          "type": "object"
        },
        {
          "properties": {
            "challenge": {
              "$ref": "#/definitions/Challenge"
            },
            "invocation": {
              "$ref": "#/definitions/ModelInvocationV1"
            },
            "type": {
              "enum": [
                "challenge_submitted"
              ],
              "type": "string"
            }
          },
          "required": [
            "challenge",
            "invocation",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "evaluation": {
              "$ref": "#/definitions/Evaluation"
            },
            "invocation": {
              "$ref": "#/definitions/ModelInvocationV1"
            },
            "type": {
              "enum": [
                "evaluation_submitted"
              ],
              "type": "string"
            }
          },
          "required": [
            "evaluation",
            "invocation",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "invocation": {
              "$ref": "#/definitions/ModelInvocationV1"
            },
            "revision": {
              "$ref": "#/definitions/Revision"
            },
            "type": {
              "enum": [
                "revision_submitted"
              ],
              "type": "string"
            }
          },
          "required": [
            "invocation",
            "revision",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "recommendation": {
              "$ref": "#/definitions/Recommendation"
            },
            "type": {
              "enum": [
                "recommendation_issued"
              ],
              "type": "string"
            }
          },
          "required": [
            "recommendation",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "decision": {
              "$ref": "#/definitions/DecisionV1"
            },
            "type": {
              "enum": [
                "human_decision_recorded"
              ],
              "type": "string"
            }
          },
          "required": [
            "decision",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "code": {
              "type": [
                "string",
                "null"
              ]
            },
            "invocation": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelInvocationV1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": "string"
            },
            "reason": {
              "description": "Operator surface only.",
              "type": [
                "string",
                "null"
              ]
            },
            "stage": {
              "type": "string"
            },
            "type": {
              "enum": [
                "run_failed"
              ],
              "type": "string"
            }
          },
          "required": [
            "message",
            "stage",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "EventV1": {
      "description": "One event of a run, with its chain fields, so a client can show the chain. The verbatim stored line is at `events.ndjson`.",
      "properties": {
        "actor": {
          "$ref": "#/definitions/Actor"
        },
        "event_id": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "occurred_at": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/EventPayloadV1"
        },
        "prev_hash": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "actor",
        "event_id",
        "hash",
        "occurred_at",
        "payload",
        "prev_hash",
        "run_id",
        "schema_version",
        "sequence"
      ],
      "type": "object"
    },
    "EvidenceMode": {
      "oneOf": [
        {
          "description": "Seeded in-memory records with scripted proof outcomes.",
          "enum": [
            "simulated"
          ],
          "type": "string"
        },
        {
          "description": "No memory backend: retrieval fails and the run degrades.",
          "enum": [
            "offline"
          ],
          "type": "string"
        },
        {
          "description": "A sealed, pre-captured Hyphae snapshot.",
          "enum": [
            "sealed_snapshot"
          ],
          "type": "string"
        },
        {
          "description": "A running Hyphae Agent Memory deployment.",
          "enum": [
            "live_hyphae"
          ],
          "type": "string"
        }
      ]
    },
    "EvidenceProvenance": {
      "description": "Where the evidence came from, read from the verification and retrieval records.",
      "oneOf": [
        {
          "description": "Seeded records checked by the scripted verifier: SIMULATED.",
          "enum": [
            "simulated"
          ],
          "type": "string"
        },
        {
          "description": "Records of a sealed Hyphae snapshot, verified with `hyphae proof verify`.",
          "enum": [
            "hyphae_snapshot"
          ],
          "type": "string"
        },
        {
          "description": "Records recalled from a running Hyphae deployment.",
          "enum": [
            "hyphae_live"
          ],
          "type": "string"
        },
        {
          "description": "No evidence record in the run.",
          "enum": [
            "none"
          ],
          "type": "string"
        },
        {
          "description": "Records of more than one kind.",
          "enum": [
            "mixed"
          ],
          "type": "string"
        }
      ]
    },
    "EvidenceReferenceV1": {
      "description": "Public view of an evidence record: no local paths, no backend internals.",
      "properties": {
        "anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend_project": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend_ref": {
          "description": "Operator surface only.",
          "type": [
            "string",
            "null"
          ]
        },
        "backend_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "description": "Retrieved content: data to show, never instructions.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "proof_error": {
          "description": "Operator surface only.",
          "type": [
            "string",
            "null"
          ]
        },
        "proof_error_reported": {
          "description": "True when proof generation failed upstream for this record.",
          "type": "boolean"
        },
        "proof_file": {
          "description": "Operator surface only.",
          "type": [
            "string",
            "null"
          ]
        },
        "proof_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "proof_request": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProofRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "proof_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieval": {
          "anyOf": [
            {
              "$ref": "#/definitions/Retrieval"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string"
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "witness_file": {
          "description": "Operator surface only.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content",
        "id",
        "kind",
        "project_id",
        "proof_error_reported",
        "retrieved_at"
      ],
      "type": "object"
    },
    "FactualStatus": {
      "description": "Factual corroboration axis only. Independent of integrity.",
      "enum": [
        "corroborated",
        "uncorroborated",
        "contradicted",
        "not_assessed"
      ],
      "type": "string"
    },
    "FailureV1": {
      "description": "Stage and code of a failed run; the English reason stays on the operator surface.",
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`failed`.",
          "type": "string"
        },
        "message": {
          "description": "Fixed statement per code.",
          "type": "string"
        },
        "reason": {
          "description": "Operator surface only: the recorded reason.",
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message",
        "stage"
      ],
      "type": "object"
    },
    "IntegrityStatus": {
      "description": "Cryptographic integrity axis only.",
      "oneOf": [
        {
          "description": "Proof was available and verified against its anchor.",
          "enum": [
            "valid"
          ],
          "type": "string"
        },
        {
          "description": "Proof was available and failed verification.",
          "enum": [
            "invalid"
          ],
          "type": "string"
        },
        {
          "description": "No proof was available for this record (includes backend offline).",
          "enum": [
            "unavailable"
          ],
          "type": "string"
        },
        {
          "description": "Verification could not complete due to infrastructure error.",
          "enum": [
            "verification_error"
          ],
          "type": "string"
        },
        {
          "description": "Verification has not been attempted.",
          "enum": [
            "not_checked"
          ],
          "type": "string"
        }
      ]
    },
    "ItemStatus": {
      "description": "Evaluator judgment on one Critic objection: `resolved` when the proposal as written no longer has the problem or the retrieved evidence shows the objection is mistaken; `unresolved` when it still applies, so it stays open into the next round.",
      "enum": [
        "resolved",
        "unresolved"
      ],
      "type": "string"
    },
    "ItemVerdict": {
      "description": "One explicit verdict on one objection, by item id (schema 1.3).",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "reason": {
          "description": "Why. Required (non-empty) for a resolved verdict: an objection is never closed without saying what settled it.",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ItemStatus"
        }
      },
      "required": [
        "item_id",
        "reason",
        "status"
      ],
      "type": "object"
    },
    "ModelInvocationV1": {
      "description": "Public view of a model call.",
      "properties": {
        "attempts": {
          "description": "Operator surface only.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "latency_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_completion_tokens": {
          "description": "Operator surface only.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "model": {
          "type": "string"
        },
        "output_tokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "prompt_sha256": {
          "description": "Operator surface only.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string"
        },
        "reasoning_tokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_name": {
          "description": "Operator surface only.",
          "type": [
            "string",
            "null"
          ]
        },
        "schema_sha256": {
          "description": "Operator surface only.",
