{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "IndexErrorCodeV1": {
      "description": "Why the run index could not be verified, as `/ready` publishes it: the kind of failure, never the store's own text.",
      "oneOf": [
        {
          "description": "The index failed verification: a record was edited, removed or added since the store opened.",
          "enum": [
            "index_tampered"
          ],
          "type": "string"
        },
        {
          "description": "A lock the store needs is held by another writer or unusable.",
          "enum": [
            "index_locked"
          ],
          "type": "string"
        },
        {
          "description": "The file system refused a read or a write.",
          "enum": [
            "index_io"
          ],
          "type": "string"
        },
        {
          "description": "Anything else the store could not read as it writes it.",
          "enum": [
            "index_unreadable"
          ],
          "type": "string"
        }
      ]
    },
    "LiveReadyV1": {
      "description": "The live mode as `/ready` reports it. `ready` is false while the ledger is tripped or unreadable, or the evidence source is not ok.",
      "properties": {
        "evidence_ok": {
          "description": "The evidence source (the sealed snapshot in production) passed its check.",
          "type": "boolean"
        },
        "ledger_ok": {
          "description": "The ledger could be read.",
          "type": "boolean"
        },
        "trip_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "tripped": {
          "type": "boolean"
        }
      },
      "required": [
        "evidence_ok",
        "ledger_ok",
        "tripped"
      ],
      "type": "object"
    },
    "RunStoreStatusV1": {
      "description": "The run store as `/ready` reports it.",
      "properties": {
        "index_error": {
          "description": "Operator surface only: the store's own error text, which can name files by path. The server logs it once per change.",
          "type": [
            "string",
            "null"
          ]
        },
        "index_error_code": {
          "anyOf": [
            {
              "$ref": "#/definitions/IndexErrorCodeV1"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the run index could not be verified at the last check, on both surfaces; absent while it verifies."
        },
        "index_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "index_seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "index_tail_repaired": {
          "type": "boolean"
        },
        "index_tampered": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "index_tail_repaired",
        "index_tampered",
        "ok"
      ],
      "type": "object"
    },
    "ShowcaseStatusV1": {
      "description": "The showcase as `/ready` reports it.",
      "properties": {
        "entries": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "ok"
      ],
      "type": "object"
    }
  },
  "description": "`GET /api/v1/ready`.",
  "properties": {
    "active_runs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "live": {
      "anyOf": [
        {
          "$ref": "#/definitions/LiveReadyV1"
        },
        {
          "type": "null"
        }
      ],
      "description": "Present when live mode is wired on this server."
    },
    "queued_runs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "ready": {
      "type": "boolean"
    },
    "run_store": {
      "$ref": "#/definitions/RunStoreStatusV1"
    },
    "showcase": {
      "$ref": "#/definitions/ShowcaseStatusV1"
    },
    "shutting_down": {
      "type": "boolean"
    }
  },
  "required": [
    "active_runs",
    "queued_runs",
    "ready",
    "run_store",
    "showcase",
    "shutting_down"
  ],
  "title": "ReadyV1",
  "type": "object"
}
