{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "RunState": {
      "description": "Deterministic lifecycle of one run. Transitions are owned and validated by the runtime state machine; see `docs/adr/0001-m1-architecture.md`.",
      "enum": [
        "created",
        "proposed",
        "evidence_review",
        "evaluated",
        "revised",
        "abstained",
        "awaiting_human_approval",
        "approved",
        "rejected",
        "failed"
      ],
      "type": "string"
    },
    "StreamEndReason": {
      "description": "Why a stream closed.",
      "oneOf": [
        {
          "description": "The run awaits a human decision; decide, then fetch the detail.",
          "enum": [
            "awaiting_human_approval"
          ],
          "type": "string"
        },
        {
          "description": "The run reached a terminal state.",
          "enum": [
            "terminal"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "`event: stream_end`: the last frame of a stream.",
  "properties": {
    "last_sequence": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "reason": {
      "$ref": "#/definitions/StreamEndReason"
    },
    "state": {
      "$ref": "#/definitions/RunState"
    }
  },
  "required": [
    "last_sequence",
    "reason",
    "state"
  ],
  "title": "StreamEndV1",
  "type": "object"
}
