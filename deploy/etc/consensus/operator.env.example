# /etc/consensus/operator.env -- overrides for the on-demand operator console
# (consensus-operator.service loads /etc/consensus/public.env first, then this
# file; a later file wins). root:consensus 0640. No secrets here either.
# Runbook: docs/deployment/runbook.md, sections 4 and 9.

# The bearer token the console requires on every /api route (at least 32
# characters). The file itself is /etc/consensus/credentials/operator.token
# (root:root 0600); the unit's LoadCredential=operator.token:... places a copy
# here, readable by the service user only while the console runs. With this
# set, the token is never printed.
CONSENSUS_OPERATOR_TOKEN_FILE=/run/credentials/consensus-operator.service/operator.token

# CONSENSUS_OPERATOR_BIND=127.0.0.1:8787 is the default (loopback only; a
# non-loopback address is refused).

# The operator unit has its own credentials directory. serve-operator reads the
# Meta key from it for model=meta runs; it never reads the Turnstile secret (the
# live configuration is read credential-free, runbook 4.1).
CONSENSUS_META_API_KEY_FILE=/run/credentials/consensus-operator.service/meta.key
CONSENSUS_TURNSTILE_SECRET_FILE=/run/credentials/consensus-operator.service/turnstile.secret

# CONSENSUS_LIVE_LEDGER_DIR is inherited from public.env: serve-operator opens that
# ledger with the server's caps and meters every model=meta run on it, on the
# operator lane, so the caps, every trip and the kill switch apply (gate G3). Its
# startup line says "Operator model=meta runs: metered on the live ledger at ...";
# without the variable it says UNMETERED. Never override it here. The directory
# must exist (serve-operator refuses to start otherwise), and
# CONSENSUS_META_MAX_COMPLETION_TOKENS must not exceed
# CONSENSUS_LIVE_MAX_COMPLETION_TOKENS (both default to 16000).
