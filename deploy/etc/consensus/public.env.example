# /etc/consensus/public.env -- Hyphae Consensus public server (serve-public).
# root:consensus 0640. NO SECRETS HERE: the Meta key and the Turnstile secret
# arrive through systemd LoadCredential (deploy/systemd/consensus-public.service)
# and are referenced below by path only. systemd reads this file as VAR=value
# lines and performs no $VAR expansion, so every value is literal.
# Variable tables: crates/consensus-api/src/public_config.rs (public server),
# crates/consensus-api/src/live/config.rs (live mode),
# crates/consensus-api/src/config.rs (Meta and Hyphae). Defaults are not set
# here; the ones worth knowing are listed, commented, at the end.
# Runbook: docs/deployment/runbook.md, section 4.

# --- Listener: the unix socket -----------------------------------------------
# CONSENSUS_PUBLIC_SOCKET defaults to /run/consensus/public.sock (mode 0660) and
# CONSENSUS_TRUST_PROXY_HEADERS to true (required with the socket). Both lists
# are REQUIRED with the socket: the public hostname and the staging hostname.
CONSENSUS_ALLOWED_ORIGINS=https://<hostname>,https://staging.<hostname>
CONSENSUS_ALLOWED_HOSTS=<hostname>,staging.<hostname>

# --- Paths -------------------------------------------------------------------
CONSENSUS_RUN_STORE_DIR=/var/lib/consensus/runs
CONSENSUS_RESEARCH_DIR=/var/lib/consensus/research
CONSENSUS_WEB_ROOT=/var/lib/consensus/web
# CONSENSUS_CSP_MANIFEST defaults to <web root>/csp-manifest.json, which the
# web build writes into out/.

# --- Public deployment ---------------------------------------------------------
CONSENSUS_PUBLIC_MODE=true
# CONSENSUS_META_DEBUG_DIR must stay unset: it is refused in public mode.

# --- Meta Model API: the dedicated public key, from a credential file --------
# CONSENSUS_META_API_KEY_FILE is being added by a parallel lane for systemd
# LoadCredential; it is the production way to supply the key. Never set
# CONSENSUS_META_API_KEY, MODEL_API_KEY or META_API_KEY on this server: an
# environment value is visible in /proc/<pid>/environ (gate G4).
CONSENSUS_META_API_KEY_FILE=/run/credentials/consensus-public.service/meta.key
# CONSENSUS_MODEL=muse-wonder-1.0 and CONSENSUS_META_BASE_URL=https://api.meta.ai/v1
# are the defaults and stay unset.

# --- Hyphae: the 4.0.0 Linux binary as an OFFLINE VERIFIER only ---------------
# HYPHAE_NATIVE_API_KEY_FILE, HYPHAE_NATIVE_ENDPOINT, HYPHAE_BASE_URL and the
# CONSENSUS_HYPHAE_*_COLLECTION variables must stay unset on the public server:
# no daemon, no store, no credentials (gate G9).
CONSENSUS_HYPHAE_BIN=/opt/hyphae/bin/hyphae
# The pinned anchor of the sealed snapshot (64 hex digits, from its manifest.json).
# Commented out until the capture exists (runbook 3.3); uncomment it together
# with CONSENSUS_SNAPSHOT_DIR below:
# CONSENSUS_HYPHAE_EXPECTED_ANCHOR=<64-hex-anchor-from-the-snapshot-manifest>
# CONSENSUS_HYPHAE_VERIFY_TIMEOUT_SECS=60 is the default.

# --- Sealed Hyphae snapshot (ADR-0008) -----------------------------------------
# The directory is consensus:consensus 0700 (files 0640 inside): witnesses are
# private, and the service user is the only account that can enter the tree.
# Commented out until the capture exists. serve-public reads it, and the anchor
# above, only with CONSENSUS_LIVE_ENABLED=true: with live mode off a set value
# earns one "[snapshot] ... not loaded or verified" notice and nothing else.
# With live mode on, unset (or the anchor missing or malformed) stops startup
# naming the variable; a snapshot that does not boot keeps the portal up with
# live mode unavailable and logs "[snapshot] live evidence unavailable: <code>"
# (runbook 8.6).
# CONSENSUS_SNAPSHOT_DIR=/var/lib/consensus/snapshots/<snapshot-id>
# CONSENSUS_SNAPSHOT_VERIFIER_DIR stays unset: the verifier is the native
# binary and sees the same paths.

# --- Public live mode (ADR-0007) ----------------------------------------------
# false while staging without live mode; true once the snapshot lines above are
# uncommented, the credential files exist and the Cloudflare rules are in place
# (runbook 8).
CONSENSUS_LIVE_ENABLED=false
# The operator console (consensus-operator.service loads this file first) meters
# its model=meta runs on the same ledger directory (runbook 4.1, 9.2).
# ONE LEDGER PER PHASE (runbook 4.5). Staging live runs spend real money that
# must not count against the production lifetime cap, and the kill-switch
# rehearsal of gate G11 trips the staging ledger (deploy/scripts/ledger.sh
# reset clears a trip), so go-live switches to an empty production ledger.
# The retired directory is archived, never reused.
#   staging phase:  CONSENSUS_LIVE_LEDGER_DIR=/var/lib/consensus/ledger/staging
#   from go-live:   CONSENSUS_LIVE_LEDGER_DIR=/var/lib/consensus/ledger/public
CONSENSUS_LIVE_LEDGER_DIR=/var/lib/consensus/ledger/staging
# Kill switch: its presence trips the ledger. Default path is
# <ledger dir>/kill-switch (deploy/scripts/kill-switch.sh reads this file to
# find it). Set only to move it:
# CONSENSUS_LIVE_KILL_SWITCH_FILE=/var/lib/consensus/ledger/staging/kill-switch
# Judge lane: SHA-256 hex digests of the invite codes, one per line, written by
# deploy/scripts/judge-codes.sh (runbook 4.3). Set it only once the file holds at
# least one digest (an empty file is refused); it is read at startup only.
# CONSENSUS_LIVE_JUDGE_CODES_FILE=/etc/consensus/judge-codes.sha256
# Daily quotas of the gate, per UTC day, kept in the process (a restart forgets
# them); the defaults stay unset:
# CONSENSUS_LIVE_CLIENT_DAILY=3       public-lane live runs per client key (IPv4 /32, IPv6 /64); then 429 live_client_quota
# CONSENSUS_LIVE_JUDGE_CODE_DAILY=5   judge-lane live runs per invite code; then 429 live_budget_judge_daily
# Turnstile (required when live mode is enabled; both may be set before):
CONSENSUS_TURNSTILE_SECRET_FILE=/run/credentials/consensus-public.service/turnstile.secret
# One bare hostname: staging.<hostname> during the staging phase, <hostname>
# from go-live on (the widget must list both hostnames).
CONSENSUS_TURNSTILE_HOSTNAME=<hostname>
# CONSENSUS_TURNSTILE_ACTION_LIVE=live-run and CONSENSUS_TURNSTILE_ACTION_SESSION=session
# are the defaults and must match the widget's data-action values.
# Caps: the defaults ARE the owner decisions, so they stay unset:
# CONSENSUS_LIVE_DAILY_USD=10.00  CONSENSUS_LIVE_LIFETIME_USD=60.00  CONSENSUS_LIVE_JUDGE_USD=15.00
# CONSENSUS_LIVE_JUDGE_DAILY_USD=<open owner decision; default = the whole judge slice>
# CONSENSUS_LIVE_EXPOSURE_DAYS=<days>  when set, daily x days <= lifetime is enforced
#   (10.00 x days <= 60.00 allows at most 6; see runbook 4.1 before setting it).
# Geography (defaults; the Cloudflare rules must carry the same codes):
# CONSENSUS_GEO_BLOCKED_COUNTRIES=AF BY KH CN HK MO CU ER ET HT IR IQ LY MM NI KP PK RU SO SY UA VE EH
# CONSENSUS_GEO_LIVE_ONLY_BLOCKED=KR

# --- Defaults applied when unset (for review; do not set unless changing) ----
# CONSENSUS_COOKIE_SECURE=true
# CONSENSUS_SESSION_TTL_SECS=86400          CONSENSUS_SESSION_MAX=50000
# CONSENSUS_GUIDED_CONCURRENCY=4            CONSENSUS_LIVE_CONCURRENCY=1
# CONSENSUS_RUN_DEADLINE_SECS=900           CONSENSUS_REQUEST_TIMEOUT_SECS=30
# CONSENSUS_SSE_MAX_PER_RUN=8  CONSENSUS_SSE_MAX_PER_CLIENT=8  CONSENSUS_SSE_MAX_GLOBAL=512
# CONSENSUS_SSE_HEARTBEAT_SECS=15  (the heartbeat that keeps streams alive through Cloudflare)
# CONSENSUS_RATE_SESSION_PER_MIN=10  CONSENSUS_RATE_RUNS_PER_MIN=6  CONSENSUS_RATE_SSE_PER_MIN=30
# CONSENSUS_RATE_TABLE_MAX=50000
# CONSENSUS_GUIDED_RING=2000  CONSENSUS_VISITOR_ACCESS_HOURS=24  CONSENSUS_VISITOR_DELETE_DAYS=7
# CONSENSUS_MAX_RUN_TOKENS=150000 (runtime default)  CONSENSUS_LIVE_RUN_TOKEN_CAP=70000
# CONSENSUS_LIVE_MAX_CONCURRENT=1  CONSENSUS_LIVE_HOURLY_ADMISSIONS=6  CONSENSUS_LIVE_BURST_FRACTION=0.25
# CONSENSUS_LIVE_MAX_COMPLETION_TOKENS=16000  CONSENSUS_LIVE_INPUT_CAP_TOKENS=32000
#   (a run's worst case is (70000 + 16000 + 32000) x $20/M = $2.36, inside the
#   $2.50 the day offers at 00:00 UTC; the input bound of a call is request
#   bytes + 1024, and the Evaluator's request over the seven snapshot records
#   needs well above 8000)
# CONSENSUS_META_PRICE_INPUT_PER_M=4.00  CONSENSUS_META_PRICE_OUTPUT_PER_M=20.00
# CONSENSUS_MODEL_TIMEOUT_SECS=120  CONSENSUS_META_MAX_COMPLETION_TOKENS=16000
# CONSENSUS_META_MAX_ATTEMPTS=3  CONSENSUS_META_RETRY_TRANSPORT_ONCE=true
# CONSENSUS_META_REASONING_EFFORT is not sent when unset.
