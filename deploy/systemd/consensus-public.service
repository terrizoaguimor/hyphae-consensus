# Hyphae Consensus public server: `consensus-api serve-public` on the unix
# socket /run/consensus/public.sock that only cloudflared reaches (ADR-0006).
# Install as /etc/systemd/system/consensus-public.service (root:root 0644).
# Runbook: docs/deployment/runbook.md, section 5. Every directive below is
# checked against systemd.exec(5), systemd.service(5), systemd.kill(5),
# systemd.resource-control(5) and systemd.unit(5); see the runbook's
# citation list and appendix A.

[Unit]
Description=Hyphae Consensus public server (serve-public)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=consensus
Group=consensus
UMask=0027

# Non-secret configuration (root:consensus 0640). systemd reads it as
# VAR=value lines; nothing is expanded.
EnvironmentFile=/etc/consensus/public.env

# Secrets: systemd copies them into /run/credentials/consensus-public.service/,
# readable by the service user only; they never enter the environment
# (gate G4). public.env points CONSENSUS_META_API_KEY_FILE and
# CONSENSUS_TURNSTILE_SECRET_FILE at these two paths.
LoadCredential=meta.key:/etc/consensus/credentials/meta.key
LoadCredential=turnstile.secret:/etc/consensus/credentials/turnstile.secret

# The socket directory /run/consensus is deliberately NOT a RuntimeDirectory=:
# systemd would own it consensus:consensus and the socket the server binds
# inside would carry the group consensus, which cloudflared would then have
# to join, and with it read everything else that group may read (the env
# files, the judge digests, the snapshot's witnesses). Instead
# deploy/tmpfiles.d/consensus.conf creates the directory at boot as
# 2750 consensus:consensus-sock: the setgid bit makes the socket inherit the
# group consensus-sock (mknod(2)), the server sets it to 0660, and the only
# extra group cloudflared has is consensus-sock. The directory is writable
# through ReadWritePaths= below.
ExecStart=/usr/local/bin/consensus-api serve-public

# SIGTERM to the main process only: the server cancels active runs and waits
# for them to reach a checkpoint (shutdown grace 60 s), then exits; remaining
# children (a hyphae verifier) get SIGKILL after TimeoutStopSec.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90
Restart=on-failure
RestartSec=5s

# --- Sandbox ---------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
# The only writable paths: the per-run store, the ledger tree (one
# sub-directory per ledger: staging, public; the kill-switch file lives in
# the active one) and the socket directory. research/, snapshots/ and web/
# stay read-only (gate G9: no writer path near the proofs). /tmp is private
# and writable through PrivateTmp=.
ReadWritePaths=/var/lib/consensus/runs /var/lib/consensus/ledger /run/consensus
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# --- Resources (a 2 GiB host shared with cloudflared and, on demand, the
# operator console) --------------------------------------------------------
MemoryHigh=768M
MemoryMax=1G
TasksMax=1024
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
