          "type": "proposal_submitted",
          "proposal": {
            "schema_version": "1.1",
            "id": "prop-1",
            "run_id": "run-944a2f45-3992-4eeb-81f3-0b71536a3e52",
            "author_role": "proposer",
            "summary": "Separate connect, pool-wait, and read timeouts; enforce an overall deadline across attempts; preserve existing retry limits; retry only idempotent or idempotency-keyed payments; and make timeout and pool settings configurable based on measured timeout stages.",
            "plan_steps": [
              "Measure current connect, pool-wait, and read timeout rates and latencies under load.",
              "Separate and configure the timeout stages while preserving the current retry policy.",
              "Add deadline budgeting across attempts and enforce idempotency-key requirements for retries.",
              "Enable or verify persistent connection reuse with bounded pool waiting.",
              "Load-test and canary the configuration before wider rollout."
            ],
            "claims": [
              {
                "id": "claim-2",
                "statement": "The existing retry policy remains unchanged in maximum attempts, eligible errors or statuses, and backoff parameters.",
                "evidence_refs": []
              },
              {
                "id": "claim-3",
                "statement": "A payment request is retried only when it is idempotent or carries an idempotency key, and every retry reuses the same key.",
                "evidence_refs": []
              },
              {
                "id": "claim-4",
                "statement": "One overall request deadline is enforced across all attempts, and no new attempt starts after that deadline expires.",
                "evidence_refs": []
              },
              {
                "id": "claim-5",
                "statement": "Connect, connection-pool wait, and read timeouts are configured separately, with each attempt limited to the remaining overall deadline.",
                "evidence_refs": []
              },
              {
                "id": "claim-6",
                "statement": "Persistent connections are reused and pool waiting is bounded; if pool exhaustion is measured, pool size is increased only through configuration with a finite queue timeout.",
                "evidence_refs": []
              },
              {
                "id": "claim-7",
                "statement": "Each attempt logs or emits metrics for timeout stage, attempt number, elapsed time, and pool wait, without payment credentials or card data.",
                "evidence_refs": []
              },
              {
                "id": "claim-8",
                "statement": "Timeout and pool settings are changeable by configuration and can be reverted to the previous values without a code change.",
                "evidence_refs": []
              }
            ],
            "assumptions": [
              "Existing retry constraints are defined in current code or configuration but were not provided."
            ],
            "uncertainties": [
              "No codebase, current timeout values, retry configuration, latency percentiles, connection-pool settings, or load-test results were provided, so specific numeric timeout or pool-size changes cannot be justified from evidence."
            ],
