        "payload": {
          "type": "proposal_submitted",
          "proposal": {
            "schema_version": "1.1",
            "id": "prop-1",
            "run_id": "run-0e13b786-59ec-4031-8ad1-4176bb5044b3",
            "author_role": "proposer",
            "summary": "Reuse pooled keep-alive connections, make the client timeout finite and configurable based on measured latency, and retain existing retry limits while only retrying timeouts for requests with a stable idempotency key.",
            "plan_steps": [
              "Measure client latency, pool wait time, server p99 latency, and timeout rate under representative load before choosing the timeout value.",
              "Set finite pooled-connection and per-host limits and enable keep-alive reuse.",
              "Set the configurable request timeout from measured latency data.",
              "Gate all timeout retries on a stable Idempotency-Key and preserve the existing attempt limit with jittered backoff.",
              "Add timeout, retry, and pool metrics and rerun the load test and timeout-simulation tests."
            ],
            "claims": [
              {
                "id": "claim-2",
                "statement": "The payment client will reuse pooled keep-alive connections with an explicit maximum-connections-per-host limit instead of creating unbounded or per-request connections.",
                "evidence_refs": []
              },
              {
                "id": "claim-3",
                "statement": "The request timeout will be configurable and set above the measured server p99 latency plus a stated margin, rather than hard-coded or infinite.",
                "evidence_refs": []
              },
              {
                "id": "claim-4",
                "statement": "No payment request without a stable Idempotency-Key will be automatically retried after a timeout.",
                "evidence_refs": []
              },
              {
                "id": "claim-5",
                "statement": "Any retries preserve the existing maximum attempt count and use exponential backoff with jitter.",
                "evidence_refs": []
              },
              {
                "id": "claim-6",
                "statement": "Timeouts, retry attempts, pool wait time, and latency will be logged or metered with endpoint labels but without payment credentials or full payloads.",
                "evidence_refs": []
              },
              {
                "id": "claim-7",
                "statement": "If timeouts persist, a circuit-breaker or concurrency bulkhead, if added, will fail fast rather than queue unboundedly.",
                "evidence_refs": []
              }
            ],
            "assumptions": [
              "Existing retry limit and retryable-error policy are unchanged unless explicitly stated below.",
              "Payment operations may be non-idempotent, so retries require a stable idempotency key.",
              "No codebase, timeout values, load-test results, or latency measurements were provided."
            ],
            "uncertainties": [
              "Existing timeout value, retry count, client library, connection-pool settings, and server latency distribution were not provided, so specific numeric settings cannot be justified here."
            ],
