            "schema_version": "1.1",
            "id": "prop-1",
            "run_id": "run-ba147500-a683-40b6-838f-32d96c333ffc",
            "author_role": "proposer",
            "summary": "Configure bounded, separately measured payment-client timeouts and connection-pool limits, add timeout-type observability, and preserve existing retry and idempotency behavior.",
            "plan_steps": [
              "Measure current p95/p99 connect, pool-wait, and read latency and timeout rates under representative load.",
              "Set bounded timeout and pool values from those measurements while keeping the client deadline below the caller deadline.",
              "Apply the configuration change and timeout-type observability without changing retry policy.",
              "Run unit, contract, retry-policy, and load tests at target concurrency and compare timeout rates and duplicate-payment checks against the baseline."
            ],
            "claims": [
              {
                "id": "claim-2",
                "statement": "The payment client exposes separate configurable connect, connection-pool wait, and read timeouts, with each value bounded and the total client deadline below the caller deadline.",
                "evidence_refs": []
              },
              {
                "id": "claim-3",
                "statement": "No change is made to the existing maximum retry count, retryable errors or statuses, backoff cap, or total retry budget.",
                "evidence_refs": []
              },
              {
                "id": "claim-4",
                "statement": "A payment request is retried only when permitted by the existing policy and it carries an idempotency key or is explicitly marked idempotent.",
                "evidence_refs": []
              },
              {
                "id": "claim-5",
                "statement": "Connection-pool maximum total and per-route limits are configurable rather than hard-coded in request paths.",
                "evidence_refs": []
              },
              {
                "id": "claim-6",
                "statement": "Each timeout emits a metric and structured log field identifying timeout type, route, attempt number, and elapsed time, without logging payment credentials or full payment payloads.",
                "evidence_refs": []
              },
              {
                "id": "claim-7",
                "statement": "No change is made to payment request or response semantics, authentication, or amount and recipient handling.",
                "evidence_refs": []
              }
            ],
            "assumptions": [
              "Current timeout, pool, latency, and load values were not provided, so specific numeric limits require validation against those measurements before deployment."
            ],
            "uncertainties": [
              "No repository files, current timeout values, retry policy, latency distribution, pool settings, or load-test results were provided.",
              "The root cause is not established; pool exhaustion, slow upstream responses, and network latency remain distinguishable only after phase-specific measurements."
