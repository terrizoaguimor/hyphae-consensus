        "payload": {
          "type": "proposal_submitted",
          "proposal": {
            "schema_version": "1.1",
            "id": "prop-1",
            "run_id": "run-b0e82ec4-cc52-4a2f-aee2-ecfd9faa5f3e",
            "author_role": "proposer",
            "summary": "Modify only the payment retry delay calculation to apply bounded equal jitter to the existing backoff, preserving the existing backoff ceiling and attempt limit while spreading retry times.",
            "plan_steps": [
              "Locate the existing payment retry backoff calculation and its sleep or scheduler call site in the codebase.",
              "Introduce or reuse an injectable random-source dependency at that delay calculation point.",
              "Replace the directly scheduled deterministic backoff with the bounded equal-jitter calculation defined in C2 while retaining the existing backoff and cap from C1.",
              "Confirm through diff inspection that the attempt limit, retry eligibility, attempt counting, and payment execution logic are untouched.",
              "Add deterministic unit tests, bound or property tests, and a persistent-failure attempt-count test using a fake sleeper or clock.",
              "Run the existing payment retry test suite and any relevant concurrency tests."
            ],
            "claims": [
              {
                "id": "claim-2",
                "statement": "For retry attempt n, the implementation first computes base_n with the existing backoff formula and existing cap, without changing that formula, its inputs, or the cap.",
                "evidence_refs": []
              },
              {
                "id": "claim-3",
                "statement": "The scheduled retry delay uses equal jitter: delay_n = base_n/2 + uniform_random(0, base_n/2), so delay_n is always in the interval [base_n/2, base_n].",
                "evidence_refs": []
              },
              {
                "id": "claim-4",
                "statement": "A fresh random value is drawn independently for each retry attempt and for each payment operation rather than reusing one cached jitter value across retries or operations.",
                "evidence_refs": []
              },
              {
                "id": "claim-5",
                "statement": "The maximum number of payment attempts, including the existing attempt limit and attempt-counting location, is unchanged.",
                "evidence_refs": []
              },
              {
                "id": "claim-6",
                "statement": "The jitter change affects only the delay before a retry; it does not change retry eligibility, error classification, payment payloads, idempotency keys, or success and failure handling.",
                "evidence_refs": []
              },
              {
                "id": "claim-7",
                "statement": "The delay calculation never produces a negative duration, never exceeds base_n, and is applied through the existing sleep or scheduler mechanism without adding a new retry loop.",
                "evidence_refs": []
              },
              {
                "id": "claim-8",
                "statement": "The random source used in production is the platform or existing project-approved thread-safe random generator, and it is injectable or seedable in tests.",
                "evidence_refs": []
              }
            ],
            "assumptions": [
              "The payment retry path already computes a non-negative backoff duration, enforces an attempt limit, and uses an existing sleep or scheduler mechanism.",
              "Jitter is only intended to desynchronize retry timing; it is not intended to change which errors are retryable."
            ],
            "uncertainties": [
              "No codebase, file paths, programming language, current backoff formula, cap value, numeric attempt limit, random-generator utility, or test framework was provided, so those implementation-specific details cannot be named or verified here.",
              "Whether base_n can be zero and how the existing code handles zero-duration delays were not provided, so the implementation must follow the existing behavior for that edge case."
            ],
