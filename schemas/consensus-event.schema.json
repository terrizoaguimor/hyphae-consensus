{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConsensusEvent",
  "description": "One line in the JSONL event log.",
  "type": "object",
  "required": [
    "actor",
    "event_id",
    "occurred_at",
    "payload",
    "run_id",
    "schema_version",
    "sequence"
  ],
  "properties": {
    "actor": {
      "$ref": "#/definitions/Actor"
    },
    "event_id": {
      "description": "Idempotency key: re-appending an event with an existing id is a no-op that returns the original sequence.",
      "type": "string"
    },
    "hash": {
      "description": "SHA-256 over (prev_hash || canonical JSON of this record with `hash` blanked). Assigned by the event log on append; validated on open/replay. Empty only on pre-1.1 records.",
      "default": "",
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    },
    "payload": {
      "$ref": "#/definitions/EventPayload"
    },
    "prev_hash": {
      "description": "Hash-chain link: `hash` of the previous record in the file (\"genesis\" for the first). Empty only on pre-1.1 records.",
      "default": "",
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "sequence": {
      "description": "Monotonic, gap-free sequence within the log file, starting at 1. Assigned by the event log on append; validated on open/replay.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "Actor": {
      "description": "Who performed an action recorded in the event log. `Human` is the only actor kind allowed to authorize a run.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "role"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "agent"
              ]
            },
            "role": {
              "$ref": "#/definitions/AgentRole"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "runtime"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "human"
              ]
            }
          }
        }
      ]
    },
    "AgentRole": {
      "description": "The three logical agent roles. Roles may share one underlying model; they differ in instructions, context, and tool permissions.",
      "type": "string",
      "enum": [
        "proposer",
        "critic",
        "evidence_evaluator"
      ]
    },
    "Authority": {
      "description": "Under whose authority a human decision was recorded (schema 1.3).",
      "oneOf": [
        {
          "description": "The operator of this deployment.",
          "type": "string",
          "enum": [
            "operator"
          ]
        },
        {
          "description": "A public visitor deciding on their own simulated run: the record carries no operational authority.",
          "type": "string",
          "enum": [
            "public_demo"
          ]
        }
      ]
    },
    "Challenge": {
      "description": "Critic output. The critic's job is to find problems, not to agree.",
      "type": "object",
      "required": [
        "created_at",
        "id",
        "items",
        "run_id",
        "schema_version",
        "target_proposal"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChallengeItem"
          }
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "target_proposal": {
          "type": "string"
        }
      }
    },
    "ChallengeItem": {
      "description": "One specific objection raised by the Critic against a claim or plan. Items carry stable ids so resolution is tracked per objection, not per challenge document.",
      "type": "object",
      "required": [
        "description",
        "evidence_refs",
        "kind"
      ],
      "properties": {
        "claim_id": {
          "description": "Claim under challenge, when the objection targets one claim.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "evidence_refs": {
          "description": "Evidence the critic believes contradicts or constrains the claim.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ChallengeKind"
        }
      }
    },
    "ChallengeKind": {
      "type": "string",
      "enum": [
        "contradictory_evidence",
        "missing_test",
        "unsupported_claim",
        "regression_risk",
        "security_risk",
        "constraint_conflict"
      ]
    },
    "Claim": {
      "description": "One explicit, checkable assertion inside a proposal.",
      "type": "object",
      "required": [
        "evidence_refs",
        "id",
        "statement"
      ],
      "properties": {
        "evidence_refs": {
          "description": "Evidence the author believes supports this claim (may be empty, which the evaluator treats as unsupported until retrieved).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        }
      }
    },
    "ClaimAssessment": {
      "description": "Evaluator output: per-claim sufficiency judgment. Factual and relevance judgments live here; cryptographic integrity is reported separately in `EvidenceVerification` and is never inferred from this document.",
      "type": "object",
      "required": [
        "claim_id",
        "corroborated",
        "note",
        "relevant_evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "contradicting_evidence": {
          "description": "Evidence the evaluator judges to contradict this claim.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "corroborated": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "relevant_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ClearedContradiction": {
      "description": "A contradiction recorded in an earlier round that this evaluation judges no longer applies, with the reason (schema 1.3). Silence never clears a contradiction; only an entry here does.",
      "type": "object",
      "required": [
        "evidence_id",
        "reason"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "Evaluation": {
      "type": "object",
      "required": [
        "abstain",
        "assessments",
        "created_at",
        "run_id",
        "schema_version",
        "target_proposal"
      ],
      "properties": {
        "abstain": {
          "description": "True when the evaluator cannot reach a supported judgment and the correct behavior is to abstain rather than guess.",
          "type": "boolean"
        },
        "abstain_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "assessments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClaimAssessment"
          }
        },
        "cleared_contradictions": {
          "description": "Schema 1.3: contradictions carried from earlier rounds that this evaluation clears, each with its reason.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClearedContradiction"
          }
        },
        "created_at": {
          "type": "string"
        },
        "item_verdicts": {
          "description": "Schema 1.3: one verdict for every objection under evaluation, the ones still open from earlier rounds and this round's. Empty on earlier records, which judged this round's items only, implicitly.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemVerdict"
          }
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "target_proposal": {
          "type": "string"
        },
        "unresolved_items": {
          "description": "Challenge ITEM ids the evaluator judges still unresolved. From schema 1.3 exactly the ids of the `unresolved` verdicts.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "EventPayload": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "task",
            "type"
          ],
          "properties": {
            "task": {
              "$ref": "#/definitions/Task"
            },
            "type": {
              "type": "string",
              "enum": [
                "task_created"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "invocation",
            "proposal",
            "type"
          ],
          "properties": {
            "invocation": {
              "$ref": "#/definitions/ModelInvocation"
            },
            "proposal": {
              "$ref": "#/definitions/Proposal"
            },
            "type": {
              "type": "string",
              "enum": [
                "proposal_submitted"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "evidence",
            "type"
          ],
          "properties": {
            "evidence": {
              "$ref": "#/definitions/EvidenceReference"
            },
            "type": {
              "type": "string",
              "enum": [
                "evidence_retrieved"
              ]
            }
          }
        },
        {
          "description": "Retrieval was attempted but the memory backend could not serve it (e.g. Hyphae offline). The run continues with reduced evidence; see the README's offline-behavior statement.",
          "type": "object",
          "required": [
            "query",
            "reason",
            "type"
          ],
          "properties": {
            "code": {
              "description": "Schema 1.3: stable machine code next to the English `reason`.",
              "type": [
                "string",
                "null"
              ]
            },
            "query": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "evidence_unavailable"
              ]
            }
          }
        },
        {
          "description": "Schema 1.3: a proof the memory backend produced, described by what it seals: its own request, the records its result holds (none for an empty recall, which still proves absence, e.g. for project isolation), the proof artifact and the anchor it is bound to.",
          "type": "object",
          "required": [
            "anchor",
            "empty",
            "evidence_ids",
            "proof_ref",
            "request",
            "type"
          ],
          "properties": {
            "anchor": {
              "type": "string"
            },
            "empty": {
              "type": "boolean"
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "proof_ref": {
              "type": "string"
            },
            "request": {
              "$ref": "#/definitions/ProofRequest"
            },
            "type": {
              "type": "string",
              "enum": [
                "recall_proven"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "verification"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "evidence_verified"
              ]
            },
            "verification": {
              "$ref": "#/definitions/EvidenceVerification"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "challenge",
            "invocation",
            "type"
          ],
          "properties": {
            "challenge": {
              "$ref": "#/definitions/Challenge"
            },
            "invocation": {
              "$ref": "#/definitions/ModelInvocation"
            },
            "type": {
              "type": "string",
              "enum": [
                "challenge_submitted"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "evaluation",
            "invocation",
            "type"
          ],
          "properties": {
            "evaluation": {
              "$ref": "#/definitions/Evaluation"
            },
            "invocation": {
              "$ref": "#/definitions/ModelInvocation"
            },
            "type": {
              "type": "string",
              "enum": [
                "evaluation_submitted"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "invocation",
            "revision",
            "type"
          ],
          "properties": {
            "invocation": {
              "$ref": "#/definitions/ModelInvocation"
            },
            "revision": {
              "$ref": "#/definitions/Revision"
            },
            "type": {
              "type": "string",
              "enum": [
                "revision_submitted"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "recommendation",
            "type"
          ],
          "properties": {
            "recommendation": {
              "$ref": "#/definitions/Recommendation"
            },
            "type": {
              "type": "string",
              "enum": [
                "recommendation_issued"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "authorization",
            "type"
          ],
          "properties": {
            "authorization": {
              "$ref": "#/definitions/HumanAuthorization"
            },
            "type": {
              "type": "string",
              "enum": [
                "human_decision_recorded"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "reason",
            "stage",
            "type"
          ],
          "properties": {
            "code": {
              "description": "Schema 1.3: stable machine code next to the English `reason`.",
              "type": [
                "string",
                "null"
              ]
            },
            "invocation": {
              "description": "Schema 1.3: the model call whose document the runtime refused, so the call (and its tokens) still appears in the run's record.",
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelInvocation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string"
            },
            "stage": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "run_failed"
              ]
            }
          }
        }
      ]
    },
    "EvidenceMode": {
      "oneOf": [
        {
          "description": "Seeded in-memory records with scripted proof outcomes.",
          "type": "string",
          "enum": [
            "simulated"
          ]
        },
        {
          "description": "No memory backend: retrieval fails and the run degrades.",
          "type": "string",
          "enum": [
            "offline"
          ]
        },
        {
          "description": "A sealed, pre-captured Hyphae snapshot.",
          "type": "string",
          "enum": [
            "sealed_snapshot"
          ]
        },
        {
          "description": "A running Hyphae Agent Memory deployment.",
          "type": "string",
          "enum": [
            "live_hyphae"
          ]
        }
      ]
    },
    "EvidenceReference": {
      "description": "A reference to one record retrieved from the memory backend.",
      "type": "object",
      "required": [
        "content",
        "id",
        "kind",
        "project_id",
        "retrieved_at",
        "schema_version"
      ],
      "properties": {
        "anchor": {
          "description": "Snapshot/anchor identifier the proof is bound to, when the backend interface provides one.",
          "type": [
            "string",
            "null"
          ]
        },
        "backend_project": {
          "description": "Schema 1.3: the project the backend itself reported for the record, which may differ from `project_id` (the run's project).",
          "type": [
            "string",
            "null"
          ]
        },
        "backend_ref": {
          "description": "Backend-native record identifier (e.g. Hyphae memory id), when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "backend_scope": {
          "description": "Schema 1.3: the backend's scope for the record, when it reports one.",
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "description": "Schema 1.3: when that snapshot was captured (RFC 3339).",
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "description": "Retrieved content. Treated everywhere as untrusted data, never as instructions.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "proof_error": {
          "description": "Set when proof generation for this record was attempted and failed upstream (e.g. a backend corruption signal). Integrity derivation treats corruption-class messages as `Invalid`, other failures as `Unavailable` — the reason is never silently dropped.",
          "type": [
            "string",
            "null"
          ]
        },
        "proof_file": {
          "description": "Local proof artifact path for offline verification, when the backend writes proofs to disk (Hyphae memory profile does).",
          "type": [
            "string",
            "null"
          ]
        },
        "proof_ref": {
          "description": "Schema 1.3: public identifier of the proof artifact covering the record, without any local path.",
          "type": [
            "string",
            "null"
          ]
        },
        "proof_request": {
          "description": "Schema 1.3: the request the proof actually sealed. A proof covers its own request (e.g. the full record list of a project), which need not be the claim query that led the runtime to the record.",
          "anyOf": [
            {
              "$ref": "#/definitions/ProofRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "proof_sha256": {
          "description": "Schema 1.3: SHA-256 of that proof artifact, lowercase hex.",
          "type": [
            "string",
            "null"
          ]
        },
        "retrieval": {
          "description": "Schema 1.3: how the record was obtained.",
          "anyOf": [
            {
              "$ref": "#/definitions/Retrieval"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "snapshot_id": {
          "description": "Schema 1.3: the sealed snapshot the record came from, when it did.",
          "type": [
            "string",
            "null"
          ]
        },
        "witness_file": {
          "description": "Local witness artifact path paired with `proof_file`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "EvidenceVerification": {
      "description": "Full verification picture for one evidence record. The three status fields must be set from independent evidence: integrity from proof verification, factual/relevance from evaluator judgment.",
      "type": "object",
      "required": [
        "checked_at",
        "evidence_id",
        "factual_status",
        "integrity_status",
        "relevance_status",
        "schema_version"
      ],
      "properties": {
        "checked_at": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_id": {
          "type": "string"
        },
        "factual_status": {
          "$ref": "#/definitions/FactualStatus"
        },
        "integrity_status": {
          "$ref": "#/definitions/IntegrityStatus"
        },
        "proof_ref": {
          "description": "Schema 1.3: the proof artifact that was checked (the record's `proof_ref`), when it has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "relevance_status": {
          "$ref": "#/definitions/RelevanceStatus"
        },
        "report": {
          "description": "Schema 1.3: the verifier's structured report, when it gives one.",
          "anyOf": [
            {
              "$ref": "#/definitions/VerifierReport"
            },
            {
              "type": "null"
            }
          ]
        },
        "round": {
          "description": "Schema 1.3: the deliberation round (1 = first) whose evaluation this record combines with. Protocol 1.3 re-verifies every record of the round context in every round.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "schema_version": {
          "type": "string"
        },
        "verified_anchor": {
          "description": "Anchor the verification was performed against, when available.",
          "type": [
            "string",
            "null"
          ]
        },
        "verifier": {
          "description": "Verifier identity/mechanism, e.g. `hyphae proof verify`, when run.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "FactualStatus": {
      "description": "Factual corroboration axis only. Independent of integrity.",
      "type": "string",
      "enum": [
        "corroborated",
        "uncorroborated",
        "contradicted",
        "not_assessed"
      ]
    },
    "HumanAuthorization": {
      "description": "A human decision recorded against a run. Recording an approval performs no external action in M1-M3; the executor is deferred.",
      "type": "object",
      "required": [
        "approved",
        "authorized_by",
        "decided_at",
        "idempotency_key",
        "run_id",
        "schema_version"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "authority": {
          "description": "Schema 1.3: the authority the decision was taken under. Absent on earlier records, which read as unspecified, never as operator authority.",
          "anyOf": [
            {
              "$ref": "#/definitions/Authority"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorized_by": {
          "type": "string"
        },
        "decided_at": {
          "type": "string"
        },
        "idempotency_key": {
          "description": "Caller-supplied key making retries of the same decision no-ops.",
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        }
      }
    },
    "IntegrityStatus": {
      "description": "Cryptographic integrity axis only.",
      "oneOf": [
        {
          "description": "Proof was available and verified against its anchor.",
          "type": "string",
          "enum": [
            "valid"
          ]
        },
        {
          "description": "Proof was available and failed verification.",
          "type": "string",
          "enum": [
            "invalid"
          ]
        },
        {
          "description": "No proof was available for this record (includes backend offline).",
          "type": "string",
          "enum": [
            "unavailable"
          ]
        },
        {
          "description": "Verification could not complete due to infrastructure error.",
          "type": "string",
          "enum": [
            "verification_error"
          ]
        },
        {
          "description": "Verification has not been attempted.",
          "type": "string",
          "enum": [
            "not_checked"
          ]
        }
      ]
    },
    "ItemStatus": {
      "description": "Evaluator judgment on one Critic objection (schema 1.3): `resolved` when the proposal as written no longer has the problem or the retrieved evidence shows the objection is mistaken; `unresolved` when it still applies, so it stays open into the next round.",
      "type": "string",
      "enum": [
        "resolved",
        "unresolved"
      ]
    },
    "ItemVerdict": {
      "description": "One explicit verdict on one objection, by item id (schema 1.3).",
      "type": "object",
      "required": [
        "item_id",
        "reason",
        "status"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "reason": {
          "description": "Why. Required (non-empty) for a resolved verdict: an objection is never closed without saying what settled it.",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ItemStatus"
        }
      }
    },
    "ModelInvocation": {
      "description": "Metadata for one model call, recorded so Meta model participation is demonstrable from receipts. `model` preserves the exact Model API identity string returned/configured for the call.",
      "type": "object",
      "required": [
        "model",
        "provider"
      ],
      "properties": {
        "attempts": {
          "description": "Schema 1.3: HTTP attempts made for this call (retries included).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "finish_reason": {
          "description": "Schema 1.3: why the model stopped generating, as the API said it.",
          "type": [
            "string",
            "null"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_completion_tokens": {
          "description": "Schema 1.3: the output bound sent with the request, if any.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "model": {
          "type": "string"
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "prompt_sha256": {
          "description": "Schema 1.3: SHA-256 of the prompt template, lowercase hex.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string"
        },
        "reasoning_effort": {
          "description": "Schema 1.3: reasoning effort requested, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_tokens": {
          "description": "Schema 1.3: reasoning tokens, when the API reports them apart.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "safety_identifier_sent": {
          "description": "Schema 1.3: whether a pseudonymous safety identifier was sent.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "schema_name": {
          "description": "Schema 1.3: name of the structured-output schema requested.",
          "type": [
            "string",
            "null"
          ]
        },
        "schema_sha256": {
          "description": "Schema 1.3: SHA-256 of that schema as sent, lowercase hex.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ModelMode": {
      "oneOf": [
        {
          "description": "Scripted test doubles; no model is called.",
          "type": "string",
          "enum": [
            "scripted"
          ]
        },
        {
          "description": "The Meta Model API.",
          "type": "string",
          "enum": [
            "meta"
          ]
        }
      ]
    },
    "ProofRequest": {
      "description": "The request a memory proof seals (schema 1.3): the operation and arguments the proof's own result answers.",
      "type": "object",
      "required": [
        "operation",
        "project"
      ],
      "properties": {
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "operation": {
          "description": "Backend operation, e.g. `list` or `recall`.",
          "type": "string"
        },
        "project": {
          "description": "Backend project string the operation ran against.",
          "type": "string"
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Proposal": {
      "description": "Proposer output: a plan plus the claims, assumptions, and uncertainties it rests on.",
      "type": "object",
      "required": [
        "assumptions",
        "author_role",
        "claims",
        "created_at",
        "id",
        "plan_steps",
        "run_id",
        "schema_version",
        "summary",
        "uncertainties"
      ],
      "properties": {
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "author_role": {
          "$ref": "#/definitions/AgentRole"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Claim"
          }
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "plan_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Recommendation": {
      "type": "object",
      "required": [
        "issued_at",
        "kind",
        "rationale",
        "schema_version",
        "unresolved_assumptions"
      ],
      "properties": {
        "issued_at": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/RecommendationKind"
        },
        "rationale": {
          "description": "Human-readable, concise justification citing claim/evidence ids.",
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "unresolved_assumptions": {
          "description": "Assumptions that remain unresolved at decision time.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_uncertainties": {
          "description": "Schema 1.3: the final proposal's own uncertainties, carried to the human next to its assumptions.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "RecommendationKind": {
      "description": "Runtime-derived assessment of a run. Never written by a model.",
      "type": "string",
      "enum": [
        "supported",
        "contested",
        "insufficient_evidence",
        "abstained",
        "blocked"
      ]
    },
    "RelevanceStatus": {
      "description": "Relevance axis only. Independent of integrity and factuality.",
      "type": "string",
      "enum": [
        "relevant",
        "irrelevant",
        "not_assessed"
      ]
    },
    "Retrieval": {
      "description": "How an evidence record was obtained (schema 1.3).",
      "oneOf": [
        {
          "description": "A recall against a running memory backend.",
          "type": "string",
          "enum": [
            "live_recall"
          ]
        },
        {
          "description": "Served from a sealed, pre-captured snapshot.",
          "type": "string",
          "enum": [
            "sealed_snapshot"
          ]
        },
        {
          "description": "A seeded test record; any proof outcome is scripted.",
          "type": "string",
          "enum": [
            "simulated"
          ]
        }
      ]
    },
    "Revision": {
      "description": "A revision is a new proposal document that supersedes an earlier one.",
      "type": "object",
      "required": [
        "proposal",
        "schema_version",
        "supersedes"
      ],
      "properties": {
        "addressed_items": {
          "description": "Which challenge ITEMS this revision claims to address, by item id.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposal": {
          "$ref": "#/definitions/Proposal"
        },
        "schema_version": {
          "type": "string"
        },
        "supersedes": {
          "type": "string"
        }
      }
    },
    "RunOrigin": {
      "oneOf": [
        {
          "description": "The command-line demo.",
          "type": "string",
          "enum": [
            "cli"
          ]
        },
        {
          "description": "The operator console.",
          "type": "string",
          "enum": [
            "operator"
          ]
        },
        {
          "description": "The public portal.",
          "type": "string",
          "enum": [
            "public"
          ]
        }
      ]
    },
    "Task": {
      "description": "A user-defined problem submitted for multi-agent deliberation.",
      "type": "object",
      "required": [
        "created_at",
        "description",
        "id",
        "project_id",
        "run_id",
        "schema_version",
        "title"
      ],
      "properties": {
        "created_at": {
          "description": "RFC 3339 timestamp supplied by the runtime clock.",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "mode": {
          "description": "Schema 1.3: the mode the run was declared with when it was created. A declaration, not proof: what actually happened is read from the recorded invocations and verifications.",
          "anyOf": [
            {
              "$ref": "#/definitions/TaskMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "TaskMode": {
      "description": "How a run was declared at creation (schema 1.3).",
      "type": "object",
      "required": [
        "evidence",
        "model",
        "origin"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/definitions/EvidenceMode"
        },
        "model": {
          "$ref": "#/definitions/ModelMode"
        },
        "origin": {
          "$ref": "#/definitions/RunOrigin"
        },
        "preset": {
          "description": "Curated preset the task came from, when it did.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "VerifierReport": {
      "description": "Structured fields of a verifier's own report (schema 1.3), kept next to the free-text `detail` so a reader never has to parse prose.",
      "type": "object",
      "properties": {
        "anchor_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "proof_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "result_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
