{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evaluation",
  "type": "object",
  "required": [
    "abstain",
    "assessments",
    "created_at",
    "run_id",
    "schema_version",
    "target_proposal"
  ],
  "properties": {
    "abstain": {
      "description": "True when the evaluator cannot reach a supported judgment and the correct behavior is to abstain rather than guess.",
      "type": "boolean"
    },
    "abstain_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ClaimAssessment"
      }
    },
    "created_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "target_proposal": {
      "type": "string"
    },
    "unresolved_items": {
      "description": "Challenge ITEM ids the evaluator judges still unresolved.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "ClaimAssessment": {
      "description": "Evaluator output: per-claim sufficiency judgment. Factual and relevance judgments live here; cryptographic integrity is reported separately in `EvidenceVerification` and is never inferred from this document.",
      "type": "object",
      "required": [
        "claim_id",
        "corroborated",
        "note",
        "relevant_evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "contradicting_evidence": {
          "description": "Evidence the evaluator judges to contradict this claim.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "corroborated": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "relevant_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
