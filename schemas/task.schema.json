{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task",
  "description": "A user-defined problem submitted for multi-agent deliberation.",
  "type": "object",
  "required": [
    "created_at",
    "description",
    "id",
    "project_id",
    "run_id",
    "schema_version",
    "title"
  ],
  "properties": {
    "created_at": {
      "description": "RFC 3339 timestamp supplied by the runtime clock.",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  }
}
